# Pinned backend for Remote Desktop. Update commit AND checksum together.
pkgname=omarchy-remote-desktop-backend
pkgver=0.1.5.r0474d7c
pkgrel=2
pkgdesc='Pinned hypr-rdp backend with password-file authentication and session hooks'
arch=('x86_64' 'aarch64')
url='https://github.com/MuNeNICK/hypr-rdp'
license=('MIT')
provides=('hypr-rdp')
conflicts=('hypr-rdp' 'hypr-rdp-git')
options=('!debug')
depends=('ffmpeg' 'libpulse' 'libva' 'libxkbcommon' 'mesa' 'pipewire' 'wayland')
makedepends=('cargo' 'clang' 'cmake' 'git')
_commit=0474d7c9b6d7897895d758a28091d3368173e430
source=("hypr-rdp-$_commit.tar.gz::https://github.com/MuNeNICK/hypr-rdp/archive/$_commit.tar.gz"
        'reactivation-keeps-displaycontrol-size.patch')
sha256sums=('eea1adefeb2c9b981d02555ecedba4f18dc07fe93d1e33783fb7c87378eca094'
            'def2a8168136e6b93a633cf897df579dbdc72c787232049190376475ce91a7e6')

prepare() {
  cd "hypr-rdp-$_commit"
  # Local: the Confirm Active after a DisplayControl resize no longer undoes it.
  patch -Np1 -i "$srcdir/reactivation-keeps-displaycontrol-size.patch"
  cargo fetch --locked
}

build() {
  cd "hypr-rdp-$_commit"
  export CARGO_TARGET_DIR=target
  unset CFLAGS CXXFLAGS LDFLAGS
  cargo build --frozen --release
}

package() {
  cd "hypr-rdp-$_commit"
  install -Dm755 target/release/hypr-rdp "$pkgdir/usr/bin/hypr-rdp"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
